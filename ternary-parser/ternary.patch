+/// Return the type contributed by one arm of a conditional. BitInit is not a
+/// TypedInit, so it needs its own case -- exactly like the !if logic below.
+static const RecTy *GetConditionalArmType(RecordKeeper &Records,
+                                          const Init *V) {
+  if (isa<BitInit>(V))
+    return BitRecTy::get(Records);
+  if (const auto *T = dyn_cast<TypedInit>(V))
+    return T->getType();
+  return nullptr;
+}
